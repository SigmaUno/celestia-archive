# Copy to .env and fill in for docker-compose.prod.yml. Never commit .env.

# Object store (required). See README "Cloud object storage" for per-provider values.
STORE_URL=s3://my-archive-bucket/mocha-5?region=us-east-1

# Credentials. Leave empty on AWS when using an instance profile / task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Set both to when_required for non-AWS providers that reject the SDK's
# default CRC checksums (GCS, DigitalOcean Spaces).
AWS_REQUEST_CHECKSUM_CALCULATION=when_supported
AWS_RESPONSE_CHECKSUM_VALIDATION=when_supported

# Azure only (docker compose --profile azure).
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# Network
CHAIN_ID=mocha-5
PERSISTENT_PEERS=

# Tuning
SAFETY_WINDOW=100
ARCHIVE_INTERVAL=30s
PRUNE_INTERVAL=5m
RETAIN_BLOCKS=1000
LOG_LEVEL=info

# Ports
P2P_PORT=26656
METRICS_PORT=26660
UI_BIND=127.0.0.1
UI_PORT=8080
